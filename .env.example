# ── Embedding gateway ─────────────────────────────────────────────────────────
# Required. Point to your internal gateway that serves the OpenAI embeddings API.

EMBEDDING_BASE_URL=https://your-gateway.company.com/v1
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_MODEL=text-embedding-3-small

# ── Flask session signing ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

FLASK_SECRET_KEY=change-me-to-a-long-random-string

# ── Auth (optional) ───────────────────────────────────────────────────────────
# Leave SECRET_TOKEN blank to disable the login page (local single-user mode).
# Set it to a long random string to require a token on first visit.

SECRET_TOKEN=
